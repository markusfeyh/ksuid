{erl_opts, [debug_info]}.
{deps, []}.

%% ksuid is a library: its API is meant to be called from other
%% applications, so don't report exports that are unused locally.
{xref_checks, [undefined_function_calls, undefined_functions,
               locals_not_used, deprecated_function_calls,
               deprecated_functions]}.

{profiles, [
  {test, [
    {deps, [{meck, "1.2.0"}]},
    {erl_opts, [debug_info]}
  ]}
]}.
